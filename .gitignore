# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.turbo/
out/
*.tsbuildinfo

# But DO commit the vendored Bobgy WASM artifact — it's a build product
# from C++ source that needs Docker + emsdk to rebuild, and we don't want
# every contributor (or CI) to need that toolchain. Re-run
# scripts/build-wasm.sh only when lib/ai/decomposer/cpp/ changes.
!lib/ai/decomposer/dist/
!lib/ai/decomposer/dist/**

# Vercel
.vercel/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Coverage
coverage/
.nyc_output/

# Test artifacts
test-results/
playwright-report/
playwright/.cache/

# Demos
demos/preview-*.png
demos/screenshot-*.png
