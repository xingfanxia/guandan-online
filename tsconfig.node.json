{
  "compilerOptions": {
    "target": "ES2023",
    // DOM included so the api-middleware plugin (scripts/vite-api-plugin.ts)
    // and its transitive imports of lib/* — which use Request/Response/
    // Headers/ReadableStream and check `typeof window === 'undefined'` —
    // typecheck under this config. The runtime is still Node; DOM here is
    // type-information only (vite.config.ts is loaded via esbuild, no DOM
    // emit).
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "types": ["node"]
  },
  // No ESLint by choice — TS strict mode (noUnusedLocals/Parameters/
  // noUncheckedIndexedAccess), the 1022-test vitest suite,
  // `scripts/security/grep-no-leak.sh`, and Prettier formatting are the
  // discipline floor for this project. Reintroduce ESLint only if a
  // concrete rule (e.g., react-hooks/exhaustive-deps) catches a class of
  // bug not already caught by tsc + tests.
  "include": ["vite.config.ts", "vitest.config.ts"]
}
