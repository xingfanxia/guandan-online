# Dependencies
node_modules/
.pnpm-store/

# Build output
dist/
build/
.next/
.turbo/
out/
*.tsbuildinfo

# Re-include the vendored Bobgy WASM artifact (build product from C++ source
# that needs Docker + emsdk to rebuild; don't force every contributor / CI
# to install that toolchain). Re-run scripts/build-wasm.sh only when
# lib/ai/decomposer/cpp/ changes.
#
# Order matters: the broad `dist/` ignore above matches `lib/ai/decomposer/
# dist/`, so this negate MUST come after it. Moving these negate lines
# above `dist/` (or removing the parent-dir negate) will silently exclude
# the WASM artifact from commits and break the GitHub auto-deploy path.
!lib/ai/decomposer/dist/
!lib/ai/decomposer/dist/**

# Vercel
.vercel/

# Environment
.env
.env.local
.env.*.local
!.env.example

# Editor
.DS_Store
.idea/
.vscode/
*.swp
*.swo

