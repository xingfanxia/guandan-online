# Upstash Redis — each Vercel project is linked to its own Upstash instance
# (guandan-online runs separately from sibling guandan-scorer).
# Get from Vercel project Settings → Storage → Upstash Redis integration.
#
# Either naming pair works. The Vercel Marketplace integration auto-provisions
# the KV_REST_API_* pair (legacy Vercel KV-style names); the UPSTASH_REDIS_REST_*
# pair is what the @upstash/redis SDK docs use. When both are set, UPSTASH-
# prefixed wins. Locally, prefer `vercel env pull .env.local` over hand-editing.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Admin dashboard gate (SEC-3). Constant-time compare against this value.
# If unset, all admin endpoints reject (fail-closed). Same pattern as sibling scorer.
ADMIN_TOKEN=

# Vercel AI Gateway key (AI-2 Hard tier). The Hard bot tier routes
# `"deepseek/deepseek-chat"` (and any other provider/model string) through
# the gateway, which handles provider keys, failover, and cost telemetry on
# Vercel's side. When unset, Hard tier silently degrades to Medium.
AI_GATEWAY_API_KEY=

# Feature flags
FEATURE_AI_HARD=false
