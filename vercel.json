{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/sse/[roomId].ts": {
      "maxDuration": 300
    },
    "api/cron/cleanup-rooms.ts": {
      "maxDuration": 60
    },
    "api/room/[code]/move.ts": {
      "maxDuration": 30
    },
    "api/**/*.ts": {
      "maxDuration": 15
    }
  },
  "crons": [
    {
      "path": "/api/cron/cleanup-rooms",
      "schedule": "0 * * * *"
    }
  ]
}
