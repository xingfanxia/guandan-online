# Upstash Redis — shared instance with sibling guandan-scorer
# Get from Vercel project Settings → Storage → Upstash Redis integration
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Admin dashboard gate (SEC-3). Constant-time compare against this value.
# If unset, all admin endpoints reject (fail-closed). Same pattern as sibling scorer.
ADMIN_TOKEN=

# DeepSeek API key (AI-2 Hard tier). Routed through Vercel AI Gateway.
DEEPSEEK_API_KEY=

# Feature flags
FEATURE_AI_HARD=false
